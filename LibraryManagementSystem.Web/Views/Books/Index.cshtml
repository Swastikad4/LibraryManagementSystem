@model List<LibraryManagementSystem.Web.Models.Book>
@{
    Layout = "_Layout";
}

@if (TempData["Message"] != null)
{
    <div style="padding: 0.85rem; background: @((bool)(TempData["Success"] ?? false) ? "#E8F5E9" : "#FFEBEE"); color: @((bool)(TempData["Success"] ?? false) ? "#2E7D32" : "#C62828"); border-radius: 8px; margin-bottom: 1rem; font-weight: 600;">
        @TempData["Message"]
    </div>
}

<div class="table-card">
    <div class="table-toolbar">
        <button class="btn-primary" onclick="openAddModal()">➕ Add New Book</button>

        <form method="get" action="@Url.Action("Index", "Books")" class="search-box">
            <input type="text" name="search" class="form-control" placeholder="Search by title, author, ISBN..." value="@ViewBag.CurrentSearch" />
            <select name="category" class="form-control" onchange="this.form.submit()">
                <option value="All">All Categories</option>
                @foreach (var cat in ViewBag.Categories)
                {
                    <option value="@cat" selected="@(ViewBag.CurrentCategory == cat)">@cat</option>
                }
            </select>
            <button type="submit" class="btn-secondary">Search</button>
            <a href="@Url.Action("Index", "Books")" class="btn-secondary">Reset</a>
        </form>
    </div>

    <table class="custom-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>ISBN</th>
                <th>Category</th>
                <th>Publisher</th>
                <th>Qty</th>
                <th>Avail</th>
                <th>Shelf</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td><strong>@book.Title</strong></td>
                    <td>@book.Author</td>
                    <td><code>@book.ISBN</code></td>
                    <td>@book.Category</td>
                    <td>@book.Publisher</td>
                    <td>@book.Quantity</td>
                    <td><strong>@book.AvailableCopies</strong></td>
                    <td>@book.ShelfNo</td>
                    <td>
                        <span class="badge @(book.IsAvailable ? "badge-available" : "badge-borrowed")">@book.Status</span>
                    </td>
                    <td>
                        <button class="btn-secondary btn-sm" onclick='openEditModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(book)))'>Edit</button>
                        <form method="post" action="@Url.Action("Delete", "Books")" style="display:inline;" onsubmit="return confirm('Delete @book.Title?')">
                            <input type="hidden" name="id" value="@book.BookID" />
                            <button type="submit" class="btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal Dialog for Add/Edit -->
<div class="modal-overlay" id="bookModal">
    <div class="modal-card">
        <h3 id="modalTitle" style="margin-bottom: 1rem;">Add New Book</h3>
        <form method="post" action="@Url.Action("Save", "Books")">
            <input type="hidden" id="bookId" name="BookID" value="0" />

            <div class="form-group" style="margin-bottom: 0.8rem;">
                <label>Book Title</label>
                <input type="text" id="title" name="Title" class="form-control" required style="width:100%;" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; margin-bottom: 0.8rem;">
                <div>
                    <label>Author</label>
                    <input type="text" id="author" name="Author" class="form-control" required style="width:100%;" />
                </div>
                <div>
                    <label>ISBN</label>
                    <input type="text" id="isbn" name="ISBN" class="form-control" required style="width:100%;" />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; margin-bottom: 0.8rem;">
                <div>
                    <label>Category</label>
                    <input type="text" id="category" name="Category" class="form-control" required style="width:100%;" />
                </div>
                <div>
                    <label>Publisher</label>
                    <input type="text" id="publisher" name="Publisher" class="form-control" required style="width:100%;" />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.8rem; margin-bottom: 1.25rem;">
                <div>
                    <label>Quantity</label>
                    <input type="number" id="quantity" name="Quantity" class="form-control" value="1" min="1" required style="width:100%;" />
                </div>
                <div>
                    <label>Shelf No</label>
                    <input type="text" id="shelfNo" name="ShelfNo" class="form-control" value="A-01" required style="width:100%;" />
                </div>
                <div>
                    <label>Year</label>
                    <input type="number" id="publishedYear" name="PublishedYear" class="form-control" value="@DateTime.Now.Year" required style="width:100%;" />
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
                <button type="button" class="btn-secondary" onclick="closeModal()">Cancel</button>
                <button type="submit" class="btn-primary">Save Book</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function openAddModal() {
        document.getElementById('modalTitle').innerText = 'Add New Book';
        document.getElementById('bookId').value = 0;
        document.getElementById('title').value = '';
        document.getElementById('author').value = '';
        document.getElementById('isbn').value = '';
        document.getElementById('category').value = 'Fiction';
        document.getElementById('publisher').value = '';
        document.getElementById('quantity').value = 1;
        document.getElementById('shelfNo').value = 'A-01';
        document.getElementById('publishedYear').value = new Date().getFullYear();
        document.getElementById('bookModal').style.display = 'flex';
    }

    function openEditModal(book) {
        document.getElementById('modalTitle').innerText = 'Edit Book';
        document.getElementById('bookId').value = book.BookID;
        document.getElementById('title').value = book.Title;
        document.getElementById('author').value = book.Author;
        document.getElementById('isbn').value = book.ISBN;
        document.getElementById('category').value = book.Category;
        document.getElementById('publisher').value = book.Publisher;
        document.getElementById('quantity').value = book.Quantity;
        document.getElementById('shelfNo').value = book.ShelfNo;
        document.getElementById('publishedYear').value = book.PublishedYear;
        document.getElementById('bookModal').style.display = 'flex';
    }

    function closeModal() {
        document.getElementById('bookModal').style.display = 'none';
    }
</script>
}
